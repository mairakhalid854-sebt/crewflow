{
  "expo": {
    "name": "CrewFlow",
    "slug": "crewflow",
    "scheme": "crewflow",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.crewflow.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.crewflow.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CrewFlow to capture before and after photos for your assigned jobs.",
          "photosPermission": "Allow CrewFlow to select job photos when you choose to upload them."
        }
      ]
    ]
  }
}
