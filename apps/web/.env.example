# Browser-visible configuration only. Never put service-role or database secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Paddle client-side token. Its prefix selects the Paddle environment:
# test_... = sandbox (Preview/local), live_... = production (Vercel Production
# only). It is designed for browser use. Never place a Paddle API key in
# NEXT_PUBLIC_*.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Alan AI voice assistant (optional). Empty = off. The SDK key comes from the
# CrewFlow360 project in Alan AI Studio; it is a public client key.
NEXT_PUBLIC_ALAN_SDK_KEY=
# NEXT_PUBLIC_ALAN_HOST=v1.alan.app
