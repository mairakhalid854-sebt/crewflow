# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Local-only Compose defaults. Rotate every credential outside local development.
DATABASE_URL=postgresql://crewflow:crewflow_local_only@localhost:5432/crewflow?schema=public
REDIS_URL=redis://localhost:6379

# Browser-visible URL; never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-project-publishable-key

# Expo inlines only EXPO_PUBLIC_* values. Publishable key only; never use service-role keys.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-project-publishable-key

# Adapters remain disabled until an owner selects and configures a provider.
EMAIL_PROVIDER=stub
SAAS_BILLING_PROVIDER=stub
OBJECT_STORAGE_PROVIDER=local
