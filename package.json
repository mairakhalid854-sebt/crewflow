{
  "name": "crewflow",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant field service management platform",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "express": {
      "body-parser": "2.4.0"
    },
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ai:evaluate:openai": "tsx apps/api/src/ai/openai-evaluation-runner.ts",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high --workspace @crewflow/api --workspace @crewflow/scanner --workspace @crewflow/web --workspace @crewflow/worker",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev:api": "npm run dev --workspace @crewflow/api",
    "dev:mobile": "npm run start --workspace @crewflow/mobile",
    "dev:web": "npm run dev --workspace @crewflow/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "paddle:configure:sandbox": "node scripts/configure-paddle-sandbox.mjs",
    "smoke:web": "node scripts/web-smoke.mjs",
    "supabase:reset": "supabase db reset",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "test:a11y": "playwright test --config=apps/web/playwright.a11y.config.ts",
    "test:performance": "playwright test --config=apps/web/playwright.performance.config.ts",
    "test": "npm run test --workspaces --if-present && node --test scripts/web-smoke.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
